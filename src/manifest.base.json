{
  "manifest_version": 3,
  "name": "Janonismo — Não engaje a extrema direita",
  "short_name": "Janonismo",
  "version": "1.0.0",
  "description": "Quando você abre o perfil de alguém da extrema direita nas redes, o Janones aparece e manda parar.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://janonismo.vercel.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Janonismo",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*", "https://*.x.com/*",
        "https://twitter.com/*", "https://*.twitter.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.youtube.com/*",
        "https://*.facebook.com/*",
        "https://*.threads.net/*", "https://*.threads.com/*",
        "https://*.kwai.com/*",
        "https://truthsocial.com/*",
        "https://gettr.com/*",
        "https://rumble.com/*",
        "https://t.me/*", "https://telegram.me/*"
      ],
      "js": ["shared/plataformas.js", "content/overlay.js", "content/detector.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": [],
      "use_dynamic_url": true
    }
  ]
}
